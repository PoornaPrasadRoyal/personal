resource "aws_security_group" "mysg_1" {
  name   = "terraform-SG"
  vpc_id = aws_vpc.myvpc.id


  ingress {
    protocol    = "-1"
    from_port   = 0
    to_port     = 0
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    protocol    = "-1"
    from_port   = 0
    to_port     = 0
    cidr_blocks = ["0.0.0.0/0"]
  }
}

